# PostgreSQL (local default matches docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/usvibe

# TypeORM query logging (optional)
# TYPEORM_LOGGING=1

# JWT (set for auth; used after user module is enabled)
# JWT_SECRET=change-me-in-dev

# Redis (optional; JWT denylist for logout — see docs/backend/redis-usage.md)
# REDIS_URL=redis://127.0.0.1:6379
